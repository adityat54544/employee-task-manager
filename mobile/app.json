{
  "expo": {
    "name": "TaskMaster Pro",
    "slug": "employee-task-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#080C14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adityatiwari.taskmasterpro"
    },
    "android": {
      "package": "com.adityatiwari.taskmasterpro",
      "adaptiveIcon": {
        "backgroundColor": "#080C14"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
